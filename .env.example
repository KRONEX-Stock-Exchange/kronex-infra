# == API SERVER
# PORT
SERVER_PORT=3000

# == REALTIME SERVER
REALTIME_SERVER_PORT=3001

# JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# URLs are composed by docker-compose.yml from the variables below.
DATABASE_URL=
RABBITMQ_URL=

# == ENGINE
# MySQL (projection DB)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATABASE=stock

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# WAL / snapshot
WAL_DIR=./data/wal
SNAPSHOT_INTERVAL=5m
