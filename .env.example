# == API SERVER
# PORT
SERVER_PORT=3000

# == REALTIME SERVER
REALTIME_SERVER_PORT=3001

# JWT
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

DATABASE_URL=mysql://root:1234@mysql:3306/stock
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672

# == ENGINE
# MySQL (projection DB)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
